{
  "name": "@kubilaycakmak/viewports",
  "version": "3.0.1",
  "description": "Live responsive previews in desktop windows, with a CLI and MCP server",
  "type": "module",
  "bin": {
    "viewports": "bin/viewports.js"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node bin/viewports.js",
    "dev": "node bin/viewports.js http://localhost:3000",
    "test:install": "node --test test/install-electron.mjs",
    "test:desktop": "electron test/desktop-resize.mjs && electron test/desktop-presentation.mjs",
    "test:mcp": "node test/mcp-desktop.mjs"
  },
  "dependencies": {
    "@inquirer/checkbox": "^4.3.2",
    "@inquirer/select": "^4.4.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron": "^45.2.3",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "keywords": [
    "responsive",
    "viewport",
    "testing",
    "developer-tools",
    "frontend",
    "preview",
    "breakpoints",
    "infinite-canvas",
    "device-preview",
    "localhost"
  ],
  "author": "Kubilay Cakmak (https://github.com/kubilaycakmak)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubilaycakmak/viewports.git"
  },
  "homepage": "https://github.com/kubilaycakmak/viewports#readme",
  "bugs": {
    "url": "https://github.com/kubilaycakmak/viewports/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
